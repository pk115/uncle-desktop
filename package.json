{
  "name": "uncle-desktop",
  "version": "0.4.4",
  "description": "A Thai-friendly AI desktop companion with selectable characters and coding agent status.",
  "author": "TheUncleDev",
  "repository": "github:pk115/uncle-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:characters:live": "node scripts/smoke-characters.js",
    "test:characters:import": "electron scripts/test-user-characters.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "hooks:codex:install": "node scripts/install-codex-hooks.js",
    "hooks:codex:uninstall": "node scripts/install-codex-hooks.js --uninstall",
    "hooks:agy:install": "node scripts/install-hooks-agy.js",
    "hooks:agy:uninstall": "node scripts/install-hooks-agy.js --uninstall",
    "check:llm": "node scripts/check-llm.js",
    "test:hooks": "node --test tests/hooks.test.js",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "desktop-companion",
    "thai",
    "ai",
    "codex",
    "claude-code",
    "electron"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "build": {
    "appId": "uncle.desktop",
    "productName": "Uncle Desktop",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/windows.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capri.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Uncle Desktop",
      "artifactName": "Uncle-Desktop-Setup-${version}.${ext}"
    }
  },
  "contributors": [
    {
      "name": "mochiiwuff",
      "url": "https://github.com/mochiiwuff/capri-desktop"
    }
  ]
}
