{
  "name": "uncle-desktop",
  "version": "0.20.0",
  "description": "A Thai-friendly AI desktop companion with selectable characters and coding agent status.",
  "author": "TheUncleDev",
  "repository": "github:pk115/uncle-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:characters:live": "node scripts/smoke-characters.js",
    "test:characters:import": "electron scripts/test-user-characters.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "hooks:codex:install": "node scripts/install-codex-hooks.js",
    "hooks:codex:uninstall": "node scripts/install-codex-hooks.js --uninstall",
    "hooks:agy:install": "node scripts/install-hooks-agy.js",
    "hooks:agy:uninstall": "node scripts/install-hooks-agy.js --uninstall",
    "check:llm": "node scripts/check-llm.js",
    "test:hooks": "node --test tests/hooks.test.js",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac --publish never",
    "release": "electron-builder --win --publish always",
    "test:computer:live": "node scripts/smoke-computer.js",
    "prestart": "node scripts/vendor-voice-agent.js",
    "predev": "node scripts/vendor-voice-agent.js",
    "predist": "node scripts/vendor-voice-agent.js",
    "predist:mac": "node scripts/vendor-voice-agent.js && npm run build:mac-helper",
    "build:mac-helper": "mkdir -p native && swiftc -O -target arm64-apple-macos11 src/main/computer-mac.swift -o native/uncle-computer-arm64 && swiftc -O -target x86_64-apple-macos11 src/main/computer-mac.swift -o native/uncle-computer-x64 && lipo -create native/uncle-computer-arm64 native/uncle-computer-x64 -output native/uncle-computer"
  },
  "keywords": [
    "desktop-companion",
    "thai",
    "ai",
    "codex",
    "claude-code",
    "electron"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@elevenlabs/client": "1.32.1",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "electron-updater": "^6.8.11",
    "kokoro-js": "1.2.1",
    "node-edge-tts": "1.2.12"
  },
  "build": {
    "appId": "uncle.desktop",
    "productName": "Uncle Desktop",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "!scripts/run-app.js",
      "!scripts/test-*.js",
      "!scripts/smoke-*.js",
      "package.json",
      "LICENSE",
      "README.md",
      "README.th.md",
      "README.upstream.md",
      "docs/*.md",
      "!scripts/live-*.js",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**"
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/windows.ps1",
      "src/main/windows.jxa",
      "src/main/speech.ps1",
      "src/main/computer.ps1",
      "src/main/computer-native.cs",
      "src/main/computer-audio.cs"
    ],
    "win": {
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**"
      ],
      "target": "nsis",
      "icon": "assets/icons/uncle.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/uncle-512.png",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v*/win32/**"
      ],
      "category": "public.app-category.entertainment",
      "extraResources": [
        {
          "from": "native/uncle-computer",
          "to": "uncle-computer"
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Uncle Desktop listens for your voice commands when you turn the mic on.",
        "NSAppleEventsUsageDescription": "Uncle Desktop controls the volume, your music and the apps you ask her to quit."
      }
    },
    "dmg": {
      "artifactName": "Uncle-Desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Uncle Desktop",
      "artifactName": "Uncle-Desktop-Setup-${version}.${ext}"
    }
  },
  "contributors": [
    {
      "name": "mochiiwuff",
      "url": "https://github.com/mochiiwuff/capri-desktop"
    }
  ]
}
